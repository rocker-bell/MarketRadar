{
  "manifest_version": 3,
  "name": "MarketRadar",
  "version": "1.0.0",
  "description": "My browser extension",

  "icons": {
    "16": "favicon.svg",
    "48": "favicon.svg",
    "128": "favicon.svg"
  },

  "permissions": ["sidePanel"],

  "action": {
    "default_popup": "index.html",
    "default_title": "MarketRadar"
  },

  "side_panel": {
    "default_path": "index.html"
  },

  "background": {
    "service_worker": "background.js"
  }
}